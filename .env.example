# =========================
# Core Infra (Local Dev)
# =========================
DATABASE_URL=postgresql://po:po@localhost:54321/po_v2
REDIS_URL=redis://localhost:63791
APP_TZ=Asia/Kolkata
WORKER_ENABLE_DEMO_SCHEDULE=false
WORKER_DEMO_CONTRACT_ID=demo_contract
WORKER_DEMO_CRON=*/5 * * * *
WORKER_QUEUE_DRIVER=redis
WORKER_QUEUE_KEY=po_v2:worker:run_queue
DATAPLANE_MODE=local
DATAPLANE_LOCAL_SOURCE=synthetic
DATAPLANE_LOCAL_PG_URL=postgresql://po:po@localhost:54321/po_v2
DATAPLANE_AGENT_URL=http://localhost:4100
DATAPLANE_AGENT_QUERY_ENDPOINT=/v1/query
DATAPLANE_AGENT_TIMEOUT_MS=15000
DATAPLANE_AGENT_API_KEY=

# =========================
# API / Web
# =========================
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_API_BASE_URL=http://localhost:4000
WORKER_API_BASE_URL=http://localhost:4000
WEB_INTERNAL_API_KEY=
API_AUTH_REQUIRED=false
API_AUTH_TOKEN=

# =========================
# Auth (later - keep blank in MVP)
# =========================
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# =========================
# Email Provider (MVP can be console-log; later enable)
# =========================
EMAIL_PROVIDER=postmark
POSTMARK_SERVER_TOKEN=
RESEND_API_KEY=

# =========================
# LLM Provider (OpenRouter-first)
# =========================
LLM_PROVIDER=openrouterw
LLM_TIMEOUT_MS=900000
WEB_CHAT_REQUIRE_PROVIDER=true
WEB_CHAT_LLM_QUERY_ROUTER=true
WEB_ENABLE_CONVERSATION_ORCHESTRATOR=true
API_ENABLE_MERGED_QUERY_PLANNER=true

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

MODEL_GPT=anthropic/claude-sonnet-4.6
MODEL_CLAUDE=anthropic/claude-sonnet-4.6
SINGLE_QUERY_MODEL=anthropic/claude-sonnet-4.6
QUERY_STRATEGIST_MODEL=anthropic/claude-sonnet-4.6
DATA_PREPARATION_MODEL=anthropic/claude-sonnet-4.6

# Optional direct provider keys (leave blank unless used)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional attribution
OPENROUTER_APP_NAME=project_overload_v2
OPENROUTER_APP_URL=http://localhost:3000

# =========================
# Query Safety Defaults
# =========================
DEFAULT_QUERY_TIMEOUT_MS=900000
DEFAULT_QUERY_ROW_LIMIT=5000
EVIDENCE_ROW_CAP=200

# =========================
# Encryption (dev) - MUST be set in .env locally
# =========================
APP_ENCRYPTION_KEY=

# =========================
# Auth + Session (required for persisted users/sources)
# =========================
SESSION_SECRET=

# =========================
# Neon (Hosted Postgres)
# Use DATABASE_URL above for runtime DB connection.
# Optional separate URL for migration job/runner.
# =========================
NEON_DATABASE_URL=
MIGRATION_DATABASE_URL=

# =========================
# Render (Deploy API + Worker)
# =========================
RENDER_API_KEY=
RENDER_OWNER_ID=
RENDER_PROJECT_ID=
RENDER_API_SERVICE_ID=
RENDER_WORKER_SERVICE_ID=

# =========================
# Vercel (Deploy Web)
# =========================
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
